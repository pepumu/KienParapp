rules_version = '2';

// ============================================================
// Firestore Security Rules for PartyMatch
// ------------------------------------------------------------
// Paste this whole file into: Firebase Console → your project
// → Firestore Database → Rules tab → replace everything → Publish.
//
// WHAT THIS DOES:
//  - Anyone can read party info + guest lists (needed to show photos).
//  - Only the person who created a party (the host) can change its
//    settings, and only via the app.
//  - A guest can only create/edit/delete their OWN guest profile and
//    their OWN selections (nobody can pretend to be someone else).
//
// HONEST LIMITATION (please read):
// This app has no paid backend server, so "only reveal picks when it's
// mutual" is enforced by the APP'S INTERFACE, not by the database
// itself. A technically savvy guest who opens their browser's developer
// tools could see raw selection data for the party. The app never
// displays anyone's one-sided picks in the UI, so casual use is fine,
// but if you later want airtight, server-enforced privacy, that
// requires adding a Cloud Function (a paid Firebase "Blaze" plan,
// still free under normal usage) that computes matches server-side.
// Ask me to build that upgrade if/when you want it.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /parties/{partyCode} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;
      allow delete: if false;

      match /guests/{guestId} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == guestId;
        allow delete: if request.auth != null && request.auth.uid == guestId;
      }

      match /selections/{guestId} {
        // See "HONEST LIMITATION" note above: read access is open to any
        // signed-in guest so the app can compute matches client-side.
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == guestId;
        allow delete: if request.auth != null && request.auth.uid == guestId;
      }

      // Append-only audit trail of every activity pick/unpick, with a
      // timestamp. Anyone can add an entry ABOUT THEIR OWN actions (so the
      // app can log them), but nobody — not even the host — can edit or
      // delete an entry once written, and only the host can read the log.
      // This is deliberately host-only and read-only by design: it exists
      // so there's an accurate record of who selected what and when, not
      // so guests can browse each other's activity.
      match /history/{entryId} {
        allow create: if request.auth != null
                      && request.resource.data.from == request.auth.uid;
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/parties/$(partyCode)).data.hostUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // A single global settings doc the app OWNER edits directly in the
    // Firebase console (Firestore Database → Data tab → config → app) —
    // never through the app itself. Used for the free-for-everyone
    // promo/test-mode switch. Readable by everyone (so the app can check
    // it), writable by no one through client code.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
